# Image Object Detection and Text-to-Speech Inference using Hugging Face Transformers

from transformers import pipeline
from PIL import Image
from collections import Counter
from IPython.display import Audio as IPythonAudio
from PIL import ImageDraw, ImageFont
import os
import torch
import soundfile as sf
import matplotlib.pyplot as plt

# Constants
INPUT_IMAGE_PATH = "TestData/image_1.jpg"
OBJECT_DETECTION_MODEL = "facebook/detr-resnet-50"
TTS_MODEL = "microsoft/speecht5_tts"
SPEAKER_EMBEDDING_DIM = 512

# take input from file
input_img1 = Image.open(INPUT_IMAGE_PATH)

#Inference - Object Detection
obj_detector1 = (pipeline(task="object-detection", 
model=OBJECT_DETECTION_MODEL))

print(">>Object Detection Model loaded successfully!")

result1 = obj_detector1(input_img1)
# print(f">>Results of input image 1: {result1[:4]}") # print only first 4 results

# print the image with bounding boxes
draw = ImageDraw.Draw(input_img1)
for obj in result1:
    box = obj['box']
    label = obj['label']
    score = obj['score']
    draw.rectangle([(box['xmin'], box['ymin']), (box['xmax'], box['ymax'])], outline='red', width=2)
    draw.text((box['xmin'], box['ymin'] - 10), f"{label} ({score:.2f})", fill='red')

# Display the image with bounding boxes
plt.figure(figsize=(6, 4))
plt.imshow(input_img1)
plt.axis('off')  # Hide the axes
plt.show()

# Extract labels as text
labels1 = [obj['label'] for obj in result1]
labels1_count = Counter(labels1)
labels1_text = ", ".join(labels1)
print(f">>Detected objects: {dict(labels1_count)}")


#Inference - Text to Speech
narration1 = (pipeline(task="text-to-speech", 
model=TTS_MODEL))

# Create default speaker embeddings (512-dimensional vector)
# This is a workaround since the dataset can't be loaded
speaker_embeddings = torch.randn(1, 512)

# Pass speaker embeddings to the pipeline
narrated_text = narration1(labels1_text, forward_params={"speaker_embeddings": speaker_embeddings})

print(f">>Narrated Text: {narrated_text}")

# Save the audio to a file
sf.write("output_audio.wav", narrated_text["audio"], narrated_text["sampling_rate"])
print(">>Audio saved as 'output_audio.wav'")

# Play the audio using the default system player (Windows)
os.startfile("output_audio.wav")

